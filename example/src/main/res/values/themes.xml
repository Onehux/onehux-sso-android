<?xml version="1.0" encoding="utf-8"?>
<!-- onehux-sso-android/example/src/main/res/values/themes.xml
     PURPOSE: the real OneHux Accounts brand applied to a Material3 theme — ember/ivory/ink,
     Instrument Sans as the default type, rounded buttons matching the web app's own look. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.OneHuxSsoExample" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ember</item>
        <item name="colorOnPrimary">@color/ivory</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/ivory</item>
        <item name="android:colorBackground">@color/ivory</item>
        <item name="colorSurface">@color/ivory</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@color/ivory</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/ivory</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="fontFamily">@font/instrument_sans</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
    </style>

    <style name="Widget.OneHux.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ember</item>
        <item name="android:textColor">@color/ivory</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="rippleColor">@color/ember_deep</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.OneHux.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="rippleColor">@color/sand</item>
    </style>

</resources>
